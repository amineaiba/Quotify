# Copy this file to .env and fill in real values. .env is never committed.

# Postgres connection, as seen from INSIDE the Docker network (host = service name).
DATABASE_URL=postgresql+asyncpg://quotify:quotify@db:5432/quotify

# Used by docker-compose.yml to create the database.
POSTGRES_USER=quotify
POSTGRES_PASSWORD=quotify
POSTGRES_DB=quotify

# Gemini API key — free tier only. Never point this at real client data.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=changeme

EMBED_MODEL=gemini-embedding-001
AGENT_MODEL=gemini-3.6-flash

# Signs auth JWTs. Any random string for local dev — rotate before prod.
JWT_SECRET=changeme

# Meta app-level secret (shared across WhatsApp/Messenger/Instagram) — signs
# webhook payloads via X-Hub-Signature-256. From App Dashboard > Settings > Basic.
META_APP_SECRET=changeme

# Any random string you choose; paste the same value into the Meta Dashboard's
# webhook config so the GET handshake can prove you control this endpoint.
META_VERIFY_TOKEN=changeme

# WhatsApp Cloud API access token (System User token for anything long-lived —
# a Dashboard test token expires in ~24h).
WHATSAPP_ACCESS_TOKEN=changeme

# Root log level. DEBUG shows the agent loop's turn-by-turn tool calls.
LOG_LEVEL=INFO

# Origins allowed to call the API from a browser (the frontend dev server).
# Defaults to http://localhost:5173 — only set this to override it.
# CORS_ORIGINS=["http://localhost:5173"]
